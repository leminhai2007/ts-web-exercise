{
    "name": "ts-web-exercise",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "concurrently \"node server.js\" \"vite --port 5173\"",
        "dev:vite": "vite",
        "dev:server": "node server.js",
        "build": "tsc -b && vite build",
        "check:all:format": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
        "check:all:convention": "eslint .",
        "check:all": "npm run check:all:format && npm run check:all:convention",
        "fix:all:format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
        "fix:all:convention": "eslint . --fix",
        "fix:all": "npm run fix:all:format && npm run fix:all:convention",
        "check:staged": "lint-staged",
        "fix:staged": "lint-staged --config .lintstagedrc.fix.json",
        "clean": "rimraf dist node_modules/.vite",
        "preview": "vite preview",
        "serve": "serve dist",
        "playwright:mcp": "playwright-mcp --browser chromium"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fortawesome/fontawesome-svg-core": "^7.3.1",
        "@fortawesome/free-regular-svg-icons": "^7.3.1",
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "@fortawesome/react-fontawesome": "^3.5.0",
        "@mui/icons-material": "^9.4.0",
        "@mui/material": "^9.4.0",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "lz-string": "^1.5.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-router-dom": "^7.18.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/mcp": "^0.0.81",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^22.20.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vercel/node": "^13.0.1",
        "@vitejs/plugin-react": "^6.1.1",
        "concurrently": "^10.0.5",
        "eslint": "^10.10.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.5.1",
        "nodemon": "^3.1.14",
        "prettier": "^3.9.7",
        "rimraf": "^6.1.3",
        "serve": "^14.2.6",
        "tsx": "^4.23.13",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "vercel": "^59.20.0",
        "vite": "^8.3.0",
        "vite-plugin-pwa": "^1.3.0",
        "workbox-window": "^7.4.1"
    },
    "allowScripts": {
        "esbuild@0.27.0": true,
        "esbuild@0.28.2": true
    }
}
